# Telegram bot tokeni (@BotFather dan olinadi)
BOT_TOKEN=123456:ABC-DEF...

# Google Gemini API kaliti (https://aistudio.google.com/apikey)
GEMINI_API_KEY=...

# Matnni tahlil qiladigan modellar zanjiri — birinchisi band bo'lsa (503)
# yoki xato bersa, avtomatik keyingisiga o'tiladi.
GEMINI_TEXT_MODELS=gemini-3.1-flash-lite,gemini-3.7-flash,gemini-flash-latest

# Ovozli xabarni tahlil qiladigan modellar (o'zbek nutqini yaxshi tushunadiganlari)
GEMINI_VOICE_MODELS=gemini-3.7-flash,gemini-flash-latest,gemini-3-flash-preview

# Ma'lumotlar bazasi fayli
DB_PATH=data/bot.db

# Yangi foydalanuvchilar uchun standart vaqt mintaqasi
DEFAULT_TZ=Asia/Tashkent

# Eslatmalarni tekshirish oralig'i (sekund)
TICK_SECONDS=20

# Log darajasi: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
