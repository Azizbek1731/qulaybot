[Unit]
Description=Qulay Bot - AI eslatma yordamchisi (Telegram)
Documentation=https://github.com/Azizbek1731/qulaybot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/qulaybot
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/qulaybot/.venv/bin/python -m app.main
Restart=always
RestartSec=10

# Xavfsizlik: xizmat faqat oz papkasiga yoza oladi
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/qulaybot/data

# Resurs cheklovi - serverdagi boshqa xizmatlarga xalaqit bermasligi uchun
MemoryMax=400M
CPUQuota=50%

StandardOutput=journal
StandardError=journal
SyslogIdentifier=qulaybot

[Install]
WantedBy=multi-user.target
